{
  "name": "nightvision-mcp-server",
  "version": "0.2.0",
  "description": "MCP Server for NightVision CLI integration",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "clean": "rm -rf build",
    "rebuild": "npm run clean && npm run build",
    "test": "npm run build && node --test \"build/**/*.test.js\"",
    "lint": "eslint src",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:validate": "node tests/validate-package.mjs",
    "plugin:smoke": "node tests/plugin-smoke.mjs",
    "plugin:test": "npm run plugin:validate && npm run plugin:smoke"
  },
  "keywords": [
    "mcp",
    "nightvision",
    "security",
    "scanning"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.17.0",
    "form-data": "^4.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "eslint": "^10.8.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
